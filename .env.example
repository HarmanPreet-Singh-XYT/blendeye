# Used by `docker compose up` for the local ClickHouse container. web and
# agent-service run natively during dev (see their own READMEs / .env.example
# files) — only ClickHouse's credentials here are actually consumed by
# Docker; the rest exists so you have one place documenting all vars used
# across the stack.

GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# Local ClickHouse container (docker compose up clickhouse). Empty password
# is rejected by ClickHouse's HTTP auth even when "set" to empty — use a
# real value, it only needs to be memorable for local dev. Match this same
# value in agent-service/.env's CLICKHOUSE_PASSWORD.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=devpassword
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
