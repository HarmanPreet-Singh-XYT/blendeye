# ==============================================================================
# BlendEye — Next.js Web Frontend Environment Template
# ==============================================================================

# Python agent-service sidecar endpoint (see ../agent-service)
AGENT_SERVICE_URL=http://localhost:8000

# Supabase — App state persistence, project versioning, and auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Modern Supabase API Keys (Recommended)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Legacy Supabase API Keys (Supported for backwards compatibility)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# (Optional) Direct Google Cloud AI key for Next.js route fallback
GOOGLE_API_KEY=
