# Gemini / Google Cloud — required (hackathon rules: Google Cloud AI only)
GOOGLE_API_KEY=
# Set true to use Vertex AI auth instead of AI Studio API key auth
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# Supabase — used to persist Veo-generated videos directly to cloud storage.
# Required when Next.js is hosted on Vercel (read-only filesystem).
# Use your project's service-role key so the agent can bypass RLS on upload.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ClickHouse — required partner track integration.
# Below targets the local container from `docker compose up clickhouse`
# (../docker-compose.yml) — start that first, then run this service
# natively (uv run uvicorn --reload) for a fast dev loop; don't run
# agent-service itself in Docker during active development. Password must
# match CLICKHOUSE_PASSWORD in the root .env used to start that container —
# ClickHouse's HTTP auth rejects an empty password even when "set" to
# empty, confirmed by testing, so this can't default to blank.
# For ClickHouse Cloud instead: use its host, CLICKHOUSE_PORT=8443,
# CLICKHOUSE_SECURE=true, and the password/user it gives you.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=devpassword
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

# CORS — comma-separated list is not supported by pydantic-settings' default
# list parsing from env; set as a JSON array string if overriding, e.g.
# ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# Parallel Web Systems — Partner Track Integration (Search & Grounding)
PARALLEL_API_KEY=

ENVIRONMENT=development
