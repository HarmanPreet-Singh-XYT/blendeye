# Gemini / Google Cloud — required (hackathon rules: Google Cloud AI only)
GOOGLE_API_KEY=
# Set true to use Vertex AI auth instead of AI Studio API key auth
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse — required partner track integration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# CORS — comma-separated list is not supported by pydantic-settings' default
# list parsing from env; set as a JSON array string if overriding, e.g.
# ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=development
